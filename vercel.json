{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "payload migrate && next build",
  "crons": [
    {
      "path": "/api/marketing/abandoned-cart",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 60
    }
  }
}
