# Скопіюйте у .env і заповніть.
# Усі зовнішні сервіси необовʼязкові: без ключа відповідна можливість просто
# вимикається, сайт працює далі.

PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=postgres://mk:mkdev@127.0.0.1:5439/mk

# Адреса сайту. На проді — бойовий домен: з нього будуються посилання в листах,
# підпис WayForPay і sitemap.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Сховище файлів. Локально це MinIO з docker-compose (він сумісний з S3),
# на проді — AWS S3 або Cloudflare R2: змінюються лише значення.
# Порожній S3_BUCKET — файли лягають локально в /media.
S3_BUCKET=mk-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mkadmin
S3_SECRET_ACCESS_KEY=mkminio123
S3_ENDPOINT=http://127.0.0.1:9000

# WayForPay. Порожньо — замовлення створюються зі статусом «очікує оплати»
WAYFORPAY_MERCHANT_LOGIN=
WAYFORPAY_MERCHANT_SECRET=

# Telegram: видача доступу до курсів і сповіщення власниці.
# Бот має бути адміністратором каналу з правом створювати запрошення.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Нова Пошта. Порожньо — місто й відділення вводяться вручну
NOVA_POSHTA_API_KEY=

# Пошта. Порожньо — листи пишуться в консоль сервера
RESEND_API_KEY=
EMAIL_FROM=

# Аналітика. Лічильники вантажаться лише після згоди відвідувача
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Checkbox (ПРРО). Фіскальний чек обовʼязковий при оплаті карткою.
# Оформлюється на ФОП клієнтки, ≈250 грн/міс
CHECKBOX_LOGIN=
CHECKBOX_PASSWORD=
CHECKBOX_LICENSE_KEY=
CHECKBOX_API_URL=https://api.checkbox.in.ua/api/v1
