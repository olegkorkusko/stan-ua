# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files: у репозиторій іде тільки зразок
!.env.example

# завантаження з адмінки, поки не підключено S3
/media

# службове
/.playwright-mcp
*.stackdump
/mk-*.png

# Внутрішні матеріали: кошториси, брифи, аудіо клієнтів.
# Тримати поруч із репозиторієм, а не всередині.
/estimate
/docs_interal
/docs_internal
/internal_docs
/.info

# figma-parity (added by /figma-parity:init)
.parity/venv/
.parity/state/
.parity/local.yaml
.parity/vendor/
# Робочі знімки екрана прогонів — десятки мегабайтів, які нікому не потрібні
# в історії. Самі пакети (.parity/packets) навпаки лишаються: це заморожені
# зліпки макета, з якими звіряється верстка.
.parity/scratch/
